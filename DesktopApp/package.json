{
  "name": "kassa-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Restaurant Pro Team",
  "description": "Cafevania Gourmet — Kassa Sistemi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node electron/dev.cjs",
    "electron:build": "vite build && npx electron-builder --win"
  },
  "build": {
    "appId": "com.cafevania.kassa",
    "productName": "Cafevania Gourmet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "CafevaniaGourmet.exe"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.9.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^8.0.0-beta.13"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
